# ===== OpenAI (필수) =====
# https://platform.openai.com/api-keys 에서 발급한 키를 넣으세요.
OPENAI_API_KEY=sk-여기에_본인_API_키를_넣으세요

# 사용할 모델 (선택, 기본: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ===== 맛집 데이터 소스 =====
# 아래 키가 있으면 search_restaurants 가 실제 평점/리뷰 수/가격대를 가져옵니다.
# 키를 비워 두면 backend/data/restaurants.json 샘플 데이터셋으로 동작합니다.

# Google Places API (New) — 평점/리뷰/가격을 모두 제공 (권장)
# 발급: Google Cloud Console → "Places API (New)" 사용 설정 + 결제수단(빌링) 등록 → API 키 발급
GOOGLE_PLACES_API_KEY=

# Kakao Local API (선택) — 지역/장소 검증용. 평점·리뷰·가격은 제공하지 않음.
# Google 키가 없을 때만 사용되며, 상세 속성은 샘플 데이터로 보강됩니다.
KAKAO_REST_KEY=
